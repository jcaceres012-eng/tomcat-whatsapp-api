# ============================================
# WHATSAPP COEXISTENCE - TEMPLATE DE CONFIGURACIÓN
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Rellena todos los valores marcados como [REQUIRED]
# 3. Verifica que todos sean correctos antes de desplegar
# 4. NUNCA comitees el archivo .env con valores reales
#
# ============================================

# ============================================
# ENTORNO
# ============================================

# Modo de ejecución: development | production | staging
NODE_ENV=production

# Puerto del servidor (Render asigna automáticamente)
PORT=3000

# ============================================
# META / FACEBOOK CONFIGURATION
# ============================================

# [REQUIRED] ID de aplicación Meta
# Obtener de: https://developers.facebook.com/apps
META_APP_ID=[REQUIRED: Ej. 1234567890123456]

# [REQUIRED] Secreto de aplicación Meta
# Obtener de: https://developers.facebook.com/apps (Settings > Basic)
# ⚠️ NUNCA compartas este valor
META_APP_SECRET=[REQUIRED: Ej. abc123def456...]

# [REQUIRED] Access Token de Meta (Graph API)
# Obtener de: https://developers.facebook.com/tools/explorer
# O mediante: https://graph.facebook.com/oauth/access_token
# ⚠️ NUNCA compartas este valor
META_ACCESS_TOKEN=[REQUIRED: Ej. EAABsbCS1iHgBACt...]

# [REQUIRED] Business Portfolio ID
# Identificador único de tu portafolio de negocio en Meta
# Obtener de: https://business.facebook.com/settings
BUSINESS_PORTFOLIO_ID=603733427671323

# [REQUIRED] WABA ID (WhatsApp Business Account)
# Identificador único de tu cuenta de negocios de WhatsApp
# Obtener de: https://business.facebook.com/wa/manage/wabas
TARGET_WABA_ID=28291929163801429

# [REQUIRED] Número de teléfono objetivo para Coexistence
# Debe estar registrado en tu WABA
# Formato: +[país][número]
TARGET_PHONE_NUMBER=+50487473359

# [OPTIONAL] Versión de Graph API a usar
# Recomendado: v26.0 o superior para Coexistence
# META_API_VERSION=v26.0

# ============================================
# WEBHOOK CONFIGURATION
# ============================================

# [REQUIRED] Token de verificación de webhook
# Valor que Meta enviará cuando valide tu webhook
# Debe coincidir con el valor en Settings de tu app
# ⚠️ IMPORTANTE: Cambia este valor en producción
VERIFY_TOKEN=tomcat_webhook_secure_token_v2

# [REQUIRED] URL base del webhook
# Debe ser HTTPS y accesible públicamente
# Usado para callbacks de Embedded Signup
WEBHOOK_URL=https://tomcat-whatsapp-api.onrender.com

# [OPTIONAL] Webhook timeout (milisegundos)
WEBHOOK_TIMEOUT=30000

# ============================================
# META PIXEL CONFIGURATION
# ============================================

# [OPTIONAL] Pixel ID para Conversions API
# Si está configurado, se enviarán eventos de conversión a Meta Pixel
# Obtener de: https://business.facebook.com/pixels
PIXEL_ID=[OPTIONAL: Ej. 1234567890123456]

# [OPTIONAL] Access Token del Pixel
# Requerido si PIXEL_ID está configurado
# Obtener de: https://business.facebook.com/settings/data-sources
PIXEL_ACCESS_TOKEN=[OPTIONAL: Ej. EAABsbCS1iHgBACt...]

# ============================================
# SEGURIDAD Y ENCRIPTACIÓN
# ============================================

# [OPTIONAL] Clave de encriptación para tokens
# Si no está configurada, se genera aleatoriamente en cada reinicio
# Para persistencia, proporciona una clave fija (32 caracteres hex)
# ENCRYPTION_KEY=abcdef0123456789abcdef0123456789

# [OPTIONAL] Hash de sesión para CSRF protection
# JWT secret para validar sesiones OAuth
# SESSION_SECRET=your-session-secret-here

# ============================================
# DATABASE CONFIGURATION (OPCIONAL)
# ============================================

# Para persistencia de datos más allá de la sesión
# Actualmente el backend usa almacenamiento en memoria

# SQLite (desarrollo recomendado)
# DATABASE_TYPE=sqlite
# DATABASE_PATH=./data/tomcat-store.db

# MongoDB (producción recomendado)
# DATABASE_TYPE=mongodb
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/tomcat-store

# PostgreSQL
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@host:port/tomcat-store

# ============================================
# LOGGING Y MONITOREO
# ============================================

# Nivel de logging: debug | info | warn | error
LOG_LEVEL=info

# [OPTIONAL] URL para envío de logs a servicio externo
# LOG_SERVICE_URL=https://logs.example.com/api/logs

# [OPTIONAL] Clave API para servicio de logs
# LOG_SERVICE_API_KEY=key_here

# ============================================
# NÚMEROS DE TELÉFONO (INFORMACIÓN)
# ============================================

# Estos valores son informativos. El número activo es TARGET_PHONE_NUMBER
# PHONE_NUMBER_ID: Se captura automáticamente durante Embedded Signup
# BUSINESS_ACCOUNT_ID: Se obtiene de META

# Después de completar Embedded Signup:
# PHONE_NUMBER_ID=[CAPTURADO AUTOMÁTICAMENTE]
# BUSINESS_ACCOUNT_ID=[DEL SISTEMA META]

# ============================================
